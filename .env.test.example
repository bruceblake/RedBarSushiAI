# Test environment configuration
FLASK_ENV=testing
TESTING=True
LOG_LEVEL=DEBUG

# Use in-memory SQLite database for testing
DATABASE_URL=sqlite:///:memory:
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Skip real API connections
DISABLE_OPENAI=True
DISABLE_TWILIO=True
DISABLE_STRIPE=True
DISABLE_DELIVERECT=True

# Prevent access to production services
PYTHONANYHERE_DB_URI=

# Optional: Uncomment the following to debug SQL queries
# SQLALCHEMY_ECHO=True