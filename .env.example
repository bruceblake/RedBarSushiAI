# Environment Variables Example
# Copy this file to .env for local development

# Core Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
PORT=5000
DEBUG=True
BASE_URL=http://localhost:5000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/redbarsushi

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-key
OPENAI_API_VERSION=2023-05-15
OPENAI_STREAMING=1
OPENAI_REALTIME_NO_DISPLAY=0

# Twilio Configuration
TWILIO_ACCOUNT_SID=ACyouraccountsid
TWILIO_AUTH_TOKEN=yourauthtoken
TWILIO_NUMBER=+1234567890

# Environment Identification
IS_STAGING=false

# Deliverect API Configuration
DELIVERECT_CLIENT_ID=your-client-id
DELIVERECT_CLIENT_SECRET=your-client-secret