# Test environment configuration
# This file is used for local development testing with mocks

# Environment
TESTING=true
FASTAPI_ENV=testing

# Use mock services by default
USE_MOCK_SERVICES=true
MOCK_SERVER_URL=http://localhost:8001

# Test database (different port to avoid conflicts)
DATABASE_URL=postgresql+asyncpg://redbarsushi:redbarsushi@localhost:5433/redbarsushi_test

# Test Redis (different port)
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/1

# Mock API keys (not real)
OPENAI_API_KEY=sk-test-mock-key
TWILIO_ACCOUNT_SID=ACtest123456789
TWILIO_AUTH_TOKEN=test-auth-token
TWILIO_PHONE_NUMBER=+15005550006
DELIVERECT_API_KEY=test-deliverect-key

# Application settings
SECRET_KEY=test-secret-key
LOG_LEVEL=DEBUG

# Test configuration
TEST_TIMEOUT=30
MOCK_DELAY_MS=0
MAX_RESPONSE_TIME_MS=500
MAX_ORDER_PROCESSING_TIME_S=3